    - target: {fileID: 1428262818458870073, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_AdditionalShaderChannelsFlag
      value: 25
      objectReference: {fileID: 0}
    - target: {fileID: 1993093969561582423, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: "2.1 \u2013 Geluid en trillen"
      objectReference: {fileID: 0}
    - target: {fileID: 1993093969561582423, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: 'Pathway: missie 2, les 2.1 Audio and Haptics'
      objectReference: {fileID: 0}
    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4291608511
      objectReference: {fileID: 0}
    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 5328449304857317508, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_Name
      value: InfoPanel 2.1
      objectReference: {fileID: 0}
    - target: {fileID: 6026127135707476349, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: "\u2022 Drie geluidsbronnen staan in deze hoek: laag bij de grond, hoog
        in de lucht en in het groene 'spook'. Doe je ogen dicht en zoek ze op het
        gehoor (spatial audio: richting en afstand).\n\u2022 Loop naar het groene
        spook: je linker controller trilt zachtjes, en harder hoe dichter je komt.\n\u2022
        Pak het rode trilblok: je voelt een tik bij aanraken en pakken (Simple Haptic
        Feedback).\n\u2022 Alle trillingen van de game lopen via \xE9\xE9n HapticsManager."
      objectReference: {fileID: 0}
    - target: {fileID: 6026127135707476349, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: 'In de game: elk spook maakt zijn eigen geluid en laat de linker controller
        trillen als het dichtbij is.'
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4284076530
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
