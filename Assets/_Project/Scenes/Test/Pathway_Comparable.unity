      objectReference: {fileID: 0}
    - target: {fileID: 1993093969561582423, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: "1.4 \u2013 Sockets"
      objectReference: {fileID: 0}
    - target: {fileID: 1993093969561582423, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: 'Pathway: missie 1, les 1.4 Sockets'
      objectReference: {fileID: 0}
    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4291608511
      objectReference: {fileID: 0}
    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 5328449304857317508, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_Name
      value: InfoPanel 1.4
      objectReference: {fileID: 0}
    - target: {fileID: 6026127135707476349, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: "\u2022 Een Socket Interactor houdt een voorwerp vast op een vaste plek.\n\u2022
        Pak de zaklamp en de spookval van de riem en steek ze terug: elk past alleen
        in zijn eigen houder (interaction layers).\n\u2022 Laat de speelgoedbeer
        van tafel 1.3 in de groene geefzone vallen: de zone pakt hem en houdt hem
        vast.\n\u2022 Laat je de zaklamp of val ergens anders liggen, dan gaan ze
        na een paar seconden terug naar de riem."
      objectReference: {fileID: 0}
    - target: {fileID: 6026127135707476349, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: 'In de game: de riem met zaklamp en spookval, en de geefzone bij een
        spook.'
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4284076530
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
