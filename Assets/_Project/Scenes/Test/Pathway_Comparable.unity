    - target: {fileID: 1993093969561582423, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: "3.2 + 3.3 \u2013 Prestaties en licht"
      objectReference: {fileID: 0}
    - target: {fileID: 1993093969561582423, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: 'Pathway: missie 3, lessen 3.2 Optimization en 3.3 Lighting'
      objectReference: {fileID: 0}
    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4291608511
      objectReference: {fileID: 0}
    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 5328449304857317508, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_Name
      value: InfoPanel 3.2
      objectReference: {fileID: 0}
    - target: {fileID: 6026127135707476349, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: "\u2022 De teller laat de fps zien. Op de Quest moet het 72 fps blijven;
        minder maakt mensen misselijk.\n\u2022 Zet met de knop de acht realtime lichten
        aan of uit en kijk wat de fps doet (test dit op de Quest, niet in de editor).\n\u2022
        De lichten in de baked-hoek staan op 'Baked'. Bak ze via Window > Rendering
        > Lighting > Generate Lighting; daarna kost dat licht tijdens het spelen
        bijna niets.\n\u2022 Daarom bakken we het licht in de kamers en houden we
        weinig realtime lichten over."
      objectReference: {fileID: 0}
    - target: {fileID: 6026127135707476349, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: 'In de game: de woonkamer met gebakken licht en maanlicht, en zo min
        mogelijk realtime lichten.'
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4284076530
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
