    - target: {fileID: 6026127135707476349, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: "\u2022 Dichtbij pak je met je hand, ver weg met de straal: dat doet
        de Near-Far Interactor.\n\u2022 Open de deur en de lade: pak ze vast (grip)
        en trek.\n\u2022 Richt de straal op de rode knop boven dit bord en druk op
        grip: het lampje gaat aan of uit.\n\u2022 Deuren en lades voegen we zelf
        toe; kastdeuren staan in een extensie van de les."
      objectReference: {fileID: 0}
    - target: {fileID: 6026127135707476349, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: 'In de game: lades en deuren openen tijdens het zoeken, en klikken op
        de zwarte deur.'
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4284076530
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
