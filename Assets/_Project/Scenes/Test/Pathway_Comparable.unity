    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: 'Pathway: missie 1, les 1.3 Grabbable GameObjects'
      objectReference: {fileID: 0}
    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4291608511
      objectReference: {fileID: 0}
    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 5328449304857317508, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_Name
      value: InfoPanel 1.3
      objectReference: {fileID: 0}
    - target: {fileID: 6026127135707476349, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: "\u2022 Pak een voorwerp met de knijpknop (grip), houd het vast, laat
        los of gooi het.\n\u2022 Elk voorwerp heeft een XR Grab Interactable en een
        Rigidbody: de physics bepaalt hoe het valt en botst.\n\u2022 Gooi je iets
        weg, dan ligt het na een paar seconden weer op zijn plek (script ReturnToStart).\n\u2022
        Ver weg? Richt de straal en pak het op afstand."
      objectReference: {fileID: 0}
    - target: {fileID: 6026127135707476349, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: 'In de game: puzzelvoorwerpen zoals de speelgoedbeer; zo kan een puzzel
        nooit mislukken.'
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4284076530
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
