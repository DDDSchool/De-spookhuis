    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: 'Pathway: missie 3, les 3.1 Comfort and Accessibility'
      objectReference: {fileID: 0}
    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4291608511
      objectReference: {fileID: 0}
    - target: {fileID: 4624703678420637314, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 5328449304857317508, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_Name
      value: InfoPanel 3.1
      objectReference: {fileID: 0}
    - target: {fileID: 6026127135707476349, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: "\u2022 Comfort is een eis, geen bijzaak: geen gedwongen camerabeweging,
        teleport als standaard en een volumeplafond.\n\u2022 Op het comfort-paneel
        links: vloeiend lopen, vignet, zittend spelen en het volume.\n\u2022 Schuif
        het volume helemaal open en druk op 'Harde piek testen': de schuif springt
        terug en het geluid blijft onder het plafond (GameSettings).\n\u2022 De les
        doet een fade en een instellingenpaneel; zittend spelen en het volumeplafond
        voegen we zelf toe."
      objectReference: {fileID: 0}
    - target: {fileID: 6026127135707476349, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: 'In de game: de comfort-instellingen in het startmenu.'
      objectReference: {fileID: 0}
    - target: {fileID: 7090908412892343167, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4284076530
      objectReference: {fileID: 0}
