    - target: {fileID: 5328449304857317508, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_Name
      value: InfoPanel 2.4
      objectReference: {fileID: 0}
    - target: {fileID: 6026127135707476349, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_text
      value: "\u2022 Het menu rechts hangt als paneel in de wereld en beweegt niet
        mee met je hoofd. Richt de straal en druk op de trekker.\n\u2022 Kijk naar
        je linkerpols: daar zit het horloge met spook-icoontjes en 'Kamer 1 van 2'.\n\u2022
        Boven het blauwe blok hangt een gedachtebel met een plaatje in plaats van
        tekst.\n\u2022 In VR werken plaatjes beter dan tekst."
      objectReference: {fileID: 0}
    - target: {fileID: 6026127135707476349, guid: a98ec2f611f3a66429cbb0a21ae37881, type: 3}
      propertyPath: m_TextStyleHashCode
